//+------------------------------------------------------------------+
//| grid_scalper_v3_improved.mq5 |
//| Improved Grid Scalper with Safety Limits |
//| Safer version with max exposure controls |
//+------------------------------------------------------------------+
#property copyright "Copyright 2025, Improved Version"
#property version   "3.00"
#property strict
#property description "IMPROVED Grid Scalper - Safety Enhanced"

#include <Trade\Trade.mqh>
#include <Trade\SymbolInfo.mqh>
#include <Trade\PositionInfo.mqh>
#include <Trade\AccountInfo.mqh>

//--- Enums
enum ENUM_TP_TYPE { TP_AVERAGE, TP_INDIVIDUAL };
enum ENUM_TRADE_DIR { DIR_BOTH, DIR_BUY, DIR_SELL };
enum ENUM_START_MODE { START_SIGNAL, START_IMMEDIATE };

//--- Input Parameters
input group "=== [1] IDENTITY & SAFETY ==="
input string      StrategyTag                = "SafeGrid";
input long        MagicNumber                = 123456;
input double      MaxDD_Percent              = 10.0;                 // Max Drawdown % (NOT $)
input double      MaxTotalRisk_Percent       = 15.0;                 // Max total account risk %
input bool        CloseOnMaxDD               = true;                 // Close all on max DD?
input double      MaxTotalLotSize            = 2.0;                  // MAX total lot size (safety)
input bool        IncludeManualTrade         = false;

input group "=== [2] GRID SETTINGS ==="
input ENUM_TRADE_DIR Trade_Direction         = DIR_BOTH;
input ENUM_START_MODE StartMode              = START_SIGNAL;         // Use signals for safety
input string      LotSequence                = "0.01,0.01,0.02,0.02,0.03,0.03,0.04,0.04,0.05,0.05"; // Safer progression
input int         MaxOrders                  = 10;                   // Max grid levels
input double      GridDistance               = 300;                  // Grid distance (points)
input double      AddToDistance              = 100;                  // Step increment
input int         IncreaseDistAfter          = 3;
input bool        UseATRForGrid              = true;                 // Adapt grid to volatility
input int         ATR_Period                 = 14;
input double      ATR_Multiplier             = 1.5;                  // Grid = ATR * multiplier

input group "=== [3] PROFIT TARGETS ==="
input ENUM_TP_TYPE TP_Type                   = TP_AVERAGE;
input double      TakeProfit                 = 500;                  // TP in points
input double      TakeProfit_ATR_Mult        = 2.0;                  // TP = ATR * multiplier (if > 0)
input bool        UseTrailing                = true;
input double      ProfitToStartTrail         = 20.0;                 // Start trail at $ profit
input double      TrailStepPoints            = 50;
input bool        TrailOnlyLast              = false;
input bool        UseStopLoss                = true;                 // USE SL for safety!
input double      SL_ATR_Mult                = 3.0;                  // SL = ATR * multiplier

input group "=== [4] ENTRY FILTERS ==="
input int         CooldownSeconds            = 300;
input bool        ApplyTimeFilter            = false;
input string      StartTime                  = "08:00";
input string      StopTime                   = "20:00";

input group "=== [5] RSI SIGNALS ==="
input bool        UseTrendFilter             = true;
input int         MA_Period                  = 50;
input int         RSI_Period                 = 14;
input double      RSI_Buy_Level              = 35.0;
input double      RSI_Sell_Level             = 65.0;
input int         RSI_Confirmation_Bars      = 2;                    // Bars to confirm signal

input group "=== [6] DASHBOARD ==="
input bool        ShowDashboard              = true;

//--- Global Objects
CTrade         m_trade;
CSymbolInfo    m_symbol;
CPositionInfo  m_position;
CAccountInfo   m_account;

//--- Global Variables
double         m_lot_array[];
int            m_rsi_handle;
double         m_rsi_buffer[];
int            m_ma_handle;
double         m_ma_buffer[];
int            m_atr_handle;
double         m_atr_buffer[];
bool           m_dd_breached = false;
datetime       m_last_close_time = 0;
datetime       m_last_tp_update = 0;
int            m_consecutive_losses = 0;

//+------------------------------------------------------------------+
//| Expert initialization |
//+------------------------------------------------------------------+
int OnInit()
{
   // Initialize Symbol
   if(!m_symbol.Name(Symbol())) {
      Print("Failed to initialize symbol");
      return(INIT_FAILED);
   }
   RefreshRates();

   // Parse Lot Array
   if(!ParseLotString(LotSequence, m_lot_array)) {
      Print("CRITICAL ERROR: Invalid LotSequence format.");
      return(INIT_PARAMETERS_INCORRECT);
   }

   // Validate max lot
   double total_lot = 0;
   for(int i = 0; i < ArraySize(m_lot_array); i++) total_lot += m_lot_array[i];
   if(total_lot > MaxTotalLotSize) {
      Alert("WARNING: Total lot sequence (", total_lot, ") exceeds MaxTotalLotSize (", MaxTotalLotSize, ")");
   }

   // Initialize Indicators
   m_rsi_handle = iRSI(Symbol(), Period(), RSI_Period, PRICE_CLOSE);
   if(m_rsi_handle == INVALID_HANDLE) {
      Print("Failed to create RSI indicator");
      return(INIT_FAILED);
   }
   ArraySetAsSeries(m_rsi_buffer, true);

   if(UseTrendFilter) {
      m_ma_handle = iMA(Symbol(), Period(), MA_Period, 0, MODE_EMA, PRICE_CLOSE);
      if(m_ma_handle == INVALID_HANDLE) {
         Print("Failed to create MA handle");
         return(INIT_FAILED);
      }
      ArraySetAsSeries(m_ma_buffer, true);
   }

   if(UseATRForGrid) {
      m_atr_handle = iATR(Symbol(), Period(), ATR_Period);
      if(m_atr_handle == INVALID_HANDLE) {
         Print("Failed to create ATR handle");
         return(INIT_FAILED);
      }
      ArraySetAsSeries(m_atr_buffer, true);
   }

   // Setup Trade Object
   m_trade.SetExpertMagicNumber(MagicNumber);
   m_trade.SetMarginMode();
   m_trade.SetDeviationInPoints(10);
   m_trade.SetTypeFilling(ORDER_FILLING_IOC);

   PrintFormat("=== Safe Grid Scalper v3.0 Initialized ===");
   PrintFormat("Magic: %d | Max DD: %.1f%% | Max Risk: %.1f%%", MagicNumber, MaxDD_Percent, MaxTotalRisk_Percent);
   PrintFormat("Max Total Lot: %.2f | Grid Levels: %d", MaxTotalLotSize, MaxOrders);

   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Expert deinitialization |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   IndicatorRelease(m_rsi_handle);
   if(UseTrendFilter) IndicatorRelease(m_ma_handle);
   if(UseATRForGrid) IndicatorRelease(m_atr_handle);
   CleanDashboard();
}

//+------------------------------------------------------------------+
//| Expert tick function |
//+------------------------------------------------------------------+
void OnTick()
{
   if(!RefreshRates()) return;

   // Check safety limits FIRST
   CheckEquityProtection();
   if(m_dd_breached) return;

   // Update indicators
   if(CopyBuffer(m_rsi_handle, 0, 0, 3, m_rsi_buffer) < 1) return;
   if(UseATRForGrid && CopyBuffer(m_atr_handle, 0, 0, 1, m_atr_buffer) < 1) return;

   // Manage grid for each direction
   ManageDirection(POSITION_TYPE_BUY);
   ManageDirection(POSITION_TYPE_SELL);

   // Update trailing and TP
   if(UseTrailing) ManageTrailing();

   // Update average TP (not every tick - throttle)
   if(TP_Type == TP_AVERAGE && TimeCurrent() - m_last_tp_update >= 1) {
      UpdateAverageTP(POSITION_TYPE_BUY);
      UpdateAverageTP(POSITION_TYPE_SELL);
      m_last_tp_update = TimeCurrent();
   }

   if(ShowDashboard) UpdateDashboard();
}

//+------------------------------------------------------------------+
//| Main Directional Manager |
//+------------------------------------------------------------------+
void ManageDirection(ENUM_POSITION_TYPE type)
{
   int count = CountPositions(type);

   // A. No Positions -> Check Entry
   if(count == 0) {
      if(!IsTradingTime()) return;
      if(TimeCurrent() - m_last_close_time < CooldownSeconds) return;

      // Check max risk before opening
      if(GetTotalExposure() >= MaxTotalRisk_Percent) {
         static datetime last_warn = 0;
         if(TimeCurrent() - last_warn > 60) {
            Print("Max exposure reached - skipping new entry");
            last_warn = TimeCurrent();
         }
         return;
      }

      bool signal = false;

      if(StartMode == START_IMMEDIATE) {
         if(type == POSITION_TYPE_BUY && (Trade_Direction == DIR_BUY || Trade_Direction == DIR_BOTH)) signal = true;
         if(type == POSITION_TYPE_SELL && (Trade_Direction == DIR_SELL || Trade_Direction == DIR_BOTH)) signal = true;
      } else {
         signal = CheckEntrySignal(type);
      }

      if(signal) OpenFirstTrade(type);
   }
   // B. Have Positions -> Manage Grid
   else {
      if(count >= MaxOrders) return;

      // Check max lot limit
      double current_lot = GetTotalLotSize(type);
      double next_lot = GetLotSize(count);
      if(current_lot + next_lot > MaxTotalLotSize) {
         static datetime last_warn = 0;
         if(TimeCurrent() - last_warn > 60) {
            Print("Max lot size reached for ", (type == POSITION_TYPE_BUY ? "BUY" : "SELL"));
            last_warn = TimeCurrent();
         }
         return;
      }

      CheckGridExpansion(type, count);
   }
}

//+------------------------------------------------------------------+
//| Check Entry Signal with Confirmation |
//+------------------------------------------------------------------+
bool CheckEntrySignal(ENUM_POSITION_TYPE type)
{
   if(type == POSITION_TYPE_BUY && Trade_Direction == DIR_SELL) return false;
   if(type == POSITION_TYPE_SELL && Trade_Direction == DIR_BUY) return false;

   // Need multiple bars for confirmation
   double rsi[];
   ArraySetAsSeries(rsi, true);
   if(CopyBuffer(m_rsi_handle, 0, 0, RSI_Confirmation_Bars + 1, rsi) < RSI_Confirmation_Bars + 1) return false;

   // Check consecutive bars below/above threshold
   if(type == POSITION_TYPE_BUY) {
      for(int i = 0; i < RSI_Confirmation_Bars; i++) {
         if(rsi[i] >= RSI_Buy_Level) return false;
      }
   } else {
      for(int i = 0; i < RSI_Confirmation_Bars; i++) {
         if(rsi[i] <= RSI_Sell_Level) return false;
      }
   }

   // Trend filter
   if(UseTrendFilter) {
      double ma[], close[];
      ArraySetAsSeries(ma, true);
      if(CopyBuffer(m_ma_handle, 0, 0, 1, ma) < 1) return false;

      close[0] = iClose(Symbol(), Period(), 0);

      if(type == POSITION_TYPE_BUY && close[0] < ma[0]) return false;  // Don't buy below MA
      if(type == POSITION_TYPE_SELL && close[0] > ma[0]) return false; // Don't sell above MA
   }

   return true;
}

//+------------------------------------------------------------------+
//| Open First Trade |
//+------------------------------------------------------------------+
void OpenFirstTrade(ENUM_POSITION_TYPE type)
{
   double lot = GetLotSize(0);
   double price = (type == POSITION_TYPE_BUY) ? m_symbol.Ask() : m_symbol.Bid();

   // Calculate dynamic SL/TP
   double sl = 0, tp = 0;
   double point = m_symbol.Point();

   if(UseATRForGrid && m_atr_handle != INVALID_HANDLE) {
      double atr = m_atr_buffer[0];

      if(UseStopLoss) {
         double sl_dist = atr * SL_ATR_Mult;
         if(type == POSITION_TYPE_BUY) sl = price - sl_dist;
         else sl = price + sl_dist;
      }

      double tp_dist = atr * TakeProfit_ATR_Mult;
      if(tp_dist > 0) {
         if(type == POSITION_TYPE_BUY) tp = price + tp_dist;
         else tp = price - tp_dist;
      }
   } else {
      if(UseStopLoss) {
         if(type == POSITION_TYPE_BUY) sl = price - 1000 * point;
         else sl = price + 1000 * point;
      }
      if(type == POSITION_TYPE_BUY) tp = price + TakeProfit * point;
      else tp = price - TakeProfit * point;
   }

   if(sl > 0) sl = NormalizeDouble(sl, m_symbol.Digits());
   if(tp > 0) tp = NormalizeDouble(tp, m_symbol.Digits());

   string typeStr = (type == POSITION_TYPE_BUY) ? "BUY" : "SELL";
   string comment = StringFormat("%s %s #1", StrategyTag, typeStr);

   bool result = false;
   if(type == POSITION_TYPE_BUY) result = m_trade.Buy(lot, Symbol(), price, sl, tp, comment);
   else result = m_trade.Sell(lot, Symbol(), price, sl, tp, comment);

   if(result && m_trade.ResultRetcode() == TRADE_RETCODE_DONE) {
      Print("OPENED: ", typeStr, " #1 at ", price, " Lot=", lot, " SL=", sl, " TP=", tp);
   } else if(!result) {
      Print("FAILED to open ", typeStr, ": ", m_trade.ResultRetcodeDescription());
   }
}

//+------------------------------------------------------------------+
//| Check Grid Expansion |
//+------------------------------------------------------------------+
void CheckGridExpansion(ENUM_POSITION_TYPE type, int current_count)
{
   // Find worst price
   double worst_price = 0;
   datetime worst_time = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(m_position.SelectByIndex(i) && IsMyPosition() && m_position.PositionType() == type) {
         if(type == POSITION_TYPE_BUY) {
            if(worst_price == 0 || m_position.PriceOpen() < worst_price) {
               worst_price = m_position.PriceOpen();
               worst_time = m_position.Time();
            }
         } else {
            if(worst_price == 0 || m_position.PriceOpen() > worst_price) {
               worst_price = m_position.PriceOpen();
               worst_time = m_position.Time();
            }
         }
      }
   }

   if(worst_price == 0) return;

   // Calculate grid distance
   double grid_dist = GridDistance;
   if(UseATRForGrid && m_atr_handle != INVALID_HANDLE) {
      grid_dist = m_atr_buffer[0] / m_symbol.Point() * ATR_Multiplier;
   }

   if(current_count >= IncreaseDistAfter) {
      grid_dist += AddToDistance;
   }

   // Check if enough time passed (prevent rapid grid expansion)
   if(TimeCurrent() - worst_time < 60) return; // Min 1 min between grid levels

   // Check distance
   bool trigger = false;
   if(type == POSITION_TYPE_BUY) {
      if(m_symbol.Ask() <= worst_price - grid_dist * m_symbol.Point()) trigger = true;
   } else {
      if(m_symbol.Bid() >= worst_price + grid_dist * m_symbol.Point()) trigger = true;
   }

   if(trigger) {
      double price = (type == POSITION_TYPE_BUY) ? m_symbol.Ask() : m_symbol.Bid();
      double lot = GetLotSize(current_count);

      // Calculate SL/TP for this grid level
      double sl = 0, tp = 0;
      double point = m_symbol.Point();

      if(UseATRForGrid && m_atr_handle != INVALID_HANDLE) {
         double atr = m_atr_buffer[0];

         if(UseStopLoss) {
            double sl_dist = atr * SL_ATR_Mult;
            if(type == POSITION_TYPE_BUY) sl = price - sl_dist;
            else sl = price + sl_dist;
         }

         double tp_dist = atr * TakeProfit_ATR_Mult;
         if(tp_dist > 0) {
            if(type == POSITION_TYPE_BUY) tp = price + tp_dist;
            else tp = price - tp_dist;
         }
      } else {
         if(UseStopLoss) {
            if(type == POSITION_TYPE_BUY) sl = price - 1000 * point;
            else sl = price + 1000 * point;
         }
         if(TP_Type == TP_INDIVIDUAL) {
            if(type == POSITION_TYPE_BUY) tp = price + TakeProfit * point;
            else tp = price - TakeProfit * point;
         }
      }

      if(sl > 0) sl = NormalizeDouble(sl, m_symbol.Digits());
      if(tp > 0) tp = NormalizeDouble(tp, m_symbol.Digits());

      string typeStr = (type == POSITION_TYPE_BUY) ? "BUY" : "SELL";
      string comment = StringFormat("%s %s #%d", StrategyTag, typeStr, current_count + 1);

      bool result = false;
      if(type == POSITION_TYPE_BUY) result = m_trade.Buy(lot, Symbol(), price, sl, tp, comment);
      else result = m_trade.Sell(lot, Symbol(), price, sl, tp, comment);

      if(result && m_trade.ResultRetcode() == TRADE_RETCODE_DONE) {
         Print("GRID ADDED: ", typeStr, " #", current_count + 1, " at ", price, " Lot=", lot);
      }
   }
}

//+------------------------------------------------------------------+
//| Update Average Take Profit |
//+------------------------------------------------------------------+
void UpdateAverageTP(ENUM_POSITION_TYPE type)
{
   double sum_prod = 0;
   double sum_vol = 0;
   double avg_price = 0;

   // Calculate weighted average
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(m_position.SelectByIndex(i) && IsMyPosition() && m_position.PositionType() == type) {
         sum_prod += m_position.PriceOpen() * m_position.Volume();
         sum_vol += m_position.Volume();
      }
   }

   if(sum_vol == 0) return;
   avg_price = sum_prod / sum_vol;

   // Calculate TP distance
   double tp_dist = TakeProfit * m_symbol.Point();
   if(UseATRForGrid && m_atr_handle != INVALID_HANDLE && TakeProfit_ATR_Mult > 0) {
      tp_dist = m_atr_buffer[0] * TakeProfit_ATR_Mult;
   }

   double new_tp = 0;
   if(type == POSITION_TYPE_BUY) new_tp = avg_price + tp_dist;
   else new_tp = avg_price - tp_dist;

   new_tp = NormalizeDouble(new_tp, m_symbol.Digits());

   // Apply to all positions (only if changed)
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(m_position.SelectByIndex(i) && IsMyPosition() && m_position.PositionType() == type) {
         double current_tp = m_position.TakeProfit();
         if(MathAbs(current_tp - new_tp) > m_symbol.Point() * 10) {
            if(m_trade.PositionModify(m_position.Ticket(), m_position.StopLoss(), new_tp)) {
               // Success - no need to log every time
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Manage Trailing Stop |
//+------------------------------------------------------------------+
void ManageTrailing()
{
   double profit_buy = 0, profit_sell = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(m_position.SelectByIndex(i) && IsMyPosition()) {
         double profit = m_position.Profit() + m_position.Swap() + m_position.Commission();
         if(m_position.PositionType() == POSITION_TYPE_BUY) profit_buy += profit;
         else profit_sell += profit;
      }
   }

   ulong last_buy = TrailOnlyLast ? GetLastTicket(POSITION_TYPE_BUY) : 0;
   ulong last_sell = TrailOnlyLast ? GetLastTicket(POSITION_TYPE_SELL) : 0;

   if(profit_buy >= ProfitToStartTrail) ApplyTrail(POSITION_TYPE_BUY, last_buy);
   if(profit_sell >= ProfitToStartTrail) ApplyTrail(POSITION_TYPE_SELL, last_sell);
}

void ApplyTrail(ENUM_POSITION_TYPE type, ulong last_ticket)
{
   double point = m_symbol.Point();
   double atr = (UseATRForGrid && m_atr_handle != INVALID_HANDLE) ? m_atr_buffer[0] : 100 * point;
   double trail_step = atr * 0.5; // Trail by 50% of ATR

   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(m_position.SelectByIndex(i) && IsMyPosition() && m_position.PositionType() == type) {
         if(TrailOnlyLast && m_position.Ticket() != last_ticket) continue;

         double price = (type == POSITION_TYPE_BUY) ? m_symbol.Bid() : m_symbol.Ask();
         double new_sl = 0;
         double open = m_position.PriceOpen();
         double current_sl = m_position.StopLoss();

         if(type == POSITION_TYPE_BUY) {
            // Price must be in profit
            if(price > open + 100 * point) {
               new_sl = price - trail_step;
               if(new_sl > open && (current_sl == 0 || new_sl > current_sl + 10 * point)) {
                  new_sl = NormalizeDouble(new_sl, m_symbol.Digits());
                  m_trade.PositionModify(m_position.Ticket(), new_sl, m_position.TakeProfit());
               }
            }
         } else {
            if(price < open - 100 * point) {
               new_sl = price + trail_step;
               if(new_sl < open && (current_sl == 0 || new_sl < current_sl - 10 * point)) {
                  new_sl = NormalizeDouble(new_sl, m_symbol.Digits());
                  m_trade.PositionModify(m_position.Ticket(), new_sl, m_position.TakeProfit());
               }
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Safety Checks |
//+------------------------------------------------------------------+
void CheckEquityProtection()
{
   double balance = m_account.Balance();
   double equity = m_account.Equity();
   double dd_percent = (balance > 0) ? ((balance - equity) / balance * 100.0) : 0;

   if(dd_percent >= MaxDD_Percent) {
      if(!m_dd_breached) {
         PrintFormat("!!! MAX DD REACHED: %.2f%% !!! Closing all positions!", dd_percent);
         if(CloseOnMaxDD) CloseAll();
         m_dd_breached = true;
      }
   } else {
      m_dd_breached = false;
   }
}

double GetTotalExposure()
{
   double total_risk = 0;
   double balance = m_account.Balance();
   if(balance == 0) return 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(m_position.SelectByIndex(i) && IsMyPosition()) {
         double sl = m_position.StopLoss();
         if(sl > 0) {
            double risk = MathAbs(m_position.PriceOpen() - sl) * m_position.Volume();
            total_risk += risk;
         }
      }
   }

   return (total_risk / balance) * 100;
}

double GetTotalLotSize(ENUM_POSITION_TYPE type)
{
   double total = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(m_position.SelectByIndex(i) && IsMyPosition() && m_position.PositionType() == type) {
         total += m_position.Volume();
      }
   }
   return total;
}

//+------------------------------------------------------------------+
//| Helpers |
//+------------------------------------------------------------------+
bool IsMyPosition() {
   if(m_position.Symbol() != Symbol()) return false;
   if(m_position.Magic() == MagicNumber) return true;
   if(IncludeManualTrade && m_position.Magic() == 0) return true;
   return false;
}

int CountPositions(ENUM_POSITION_TYPE type) {
   int cnt = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(m_position.SelectByIndex(i) && IsMyPosition() && m_position.PositionType() == type) cnt++;
   }
   return cnt;
}

double GetLotSize(int index) {
   if(index >= ArraySize(m_lot_array)) return m_lot_array[ArraySize(m_lot_array) - 1];
   return m_lot_array[index];
}

ulong GetLastTicket(ENUM_POSITION_TYPE type) {
   ulong ticket = 0;
   datetime time = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(m_position.SelectByIndex(i) && IsMyPosition() && m_position.PositionType() == type) {
         if(m_position.Time() > time) {
            time = m_position.Time();
            ticket = m_position.Ticket();
         }
      }
   }
   return ticket;
}

void CloseAll() {
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(m_position.SelectByIndex(i) && IsMyPosition()) {
         m_trade.PositionClose(m_position.Ticket());
      }
   }
   m_last_close_time = TimeCurrent();
}

bool ParseLotString(string str_in, double& result[]) {
   string parts[];
   int total = StringSplit(str_in, ',', parts);
   if(total <= 0) return false;
   ArrayResize(result, total);
   for(int i = 0; i < total; i++) result[i] = StringToDouble(parts[i]);
   return true;
}

bool RefreshRates() { return m_symbol.RefreshRates(); }

bool IsTradingTime() {
   if(!ApplyTimeFilter) return true;
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   string curr = StringFormat("%02d:%02d", dt.hour, dt.min);
   if(StartTime < StopTime) return (curr >= StartTime && curr <= StopTime);
   return (curr >= StartTime || curr <= StopTime);
}

//+------------------------------------------------------------------+
//| Dashboard |
//+------------------------------------------------------------------+
void UpdateDashboard() {
   if(!ShowDashboard) { CleanDashboard(); return; }

   string prefix = "SAFE_GRID_";
   int x = 10, y = 20, w = 260, h = 200;

   // Calculate stats
   double pBuy = 0, pSell = 0, volBuy = 0, volSell = 0;
   int cBuy = CountPositions(POSITION_TYPE_BUY);
   int cSell = CountPositions(POSITION_TYPE_SELL);

   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(m_position.SelectByIndex(i) && IsMyPosition()) {
         double profit = m_position.Profit() + m_position.Swap() + m_position.Commission();
         if(m_position.PositionType() == POSITION_TYPE_BUY) { pBuy += profit; volBuy += m_position.Volume(); }
         else { pSell += profit; volSell += m_position.Volume(); }
      }
   }

   double total_profit = pBuy + pSell;
   double equity = m_account.Equity();
   double balance = m_account.Balance();
   double dd_pct = (balance > 0) ? ((balance - equity) / balance * 100.0) : 0;
   double exposure = GetTotalExposure();

   // Create dashboard
   CreateRectLabel(prefix + "BG", x, y, w, h, C'15,15,20', C'0,200,150', 200);
   CreateLabel(prefix + "Title", "SAFE GRID SCALPER v3.0", x + 10, y + 8, C'0,255,180', 10, true);

   CreateLabel(prefix + "Equity", StringFormat("Equity: $%.2f", equity), x + 10, y + 35, clrWhite, 9);
   CreateLabel(prefix + "DD", StringFormat("Drawdown: %.2f%%", dd_pct), x + 10, y + 55, (dd_pct > 5 ? clrOrange : clrSilver), 9);
   CreateLabel(prefix + "Exp", StringFormat("Exposure: %.1f%% / %.1f%%", exposure, MaxTotalRisk_Percent), x + 10, y + 75, (exposure > MaxTotalRisk_Percent * 0.8 ? clrOrange : clrSilver), 9);
   CreateLabel(prefix + "Profit", StringFormat("Profit: $%.2f", total_profit), x + 10, y + 95, (total_profit >= 0 ? clrLime : clrRed), 9, true);
   CreateLabel(prefix + "Stats", StringFormat("BUY: %d (%.2f) | SELL: %d (%.2f)", cBuy, volBuy, cSell, volSell), x + 10, y + 120, clrSkyBlue, 9);

   if(m_dd_breached) {
      CreateLabel(prefix + "Warn", "MAX DD REACHED - STOPPED", x + 10, y + 150, clrRed, 10, true);
   }

   ChartRedraw();
}

void CreateLabel(string name, string text, int x, int y, color c, int size = 9, bool bold = false) {
   if(ObjectFind(0, name) < 0) {
      ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_BACK, false);
   }
   ObjectSetString(0, name, OBJPROP_TEXT, text);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, name, OBJPROP_COLOR, c);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, size);
   ObjectSetString(0, name, OBJPROP_FONT, bold ? "Arial Bold" : "Arial");
}

void CreateRectLabel(string name, int x, int y, int w, int h, color bg, color border, int opacity) {
   if(ObjectFind(0, name) < 0) {
      ObjectCreate(0, name, OBJ_RECTANGLE_LABEL, 0, 0, 0);
      ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, name, OBJPROP_BORDER_TYPE, BORDER_FLAT);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_BACK, false);
   }
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, name, OBJPROP_XSIZE, w);
   ObjectSetInteger(0, name, OBJPROP_YSIZE, h);
   ObjectSetInteger(0, name, OBJPROP_BGCOLOR, bg);
   ObjectSetInteger(0, name, OBJPROP_COLOR, border);
}

void CleanDashboard() { ObjectsDeleteAll(0, "SAFE_GRID_"); }
